# Cardoso Baterias — variáveis do MODO SERVIDOR (npm start).
# O modo GitHub Pages não usa este arquivo (o banco roda no navegador).
# Copie para .env e ajuste.

PORT=3000

# Banco SQLite (arquivo). Em produção, aponte para um disco persistente/volume.
DATABASE_FILE=./data/cardoso.db

# Carrega os dados demonstrativos se o banco estiver vazio (desligue em produção real).
SEED_ON_EMPTY=true

# Usuário administrador criado se não existir. TROQUE A SENHA em produção.
ADMIN_NAME=Administrador Demo
ADMIN_EMAIL=admin@cardosobaterias.demo
ADMIN_PASSWORD=Cardoso@2026

# Fuso usado em "vendas do dia/mês"
TZ=America/Sao_Paulo

# Atrás de proxy/HTTPS (Render, Railway, Nginx…)
TRUST_PROXY=false

# Intervalo (s) para cancelar pedidos com reserva expirada
EXPIRY_SWEEP_SECONDS=60

# Chatbot: "rules" (padrão, sem custo). Para IA futura, crie server/chat-providers/<nome>.js
# e informe a chave SOMENTE aqui no servidor — nunca no navegador.
CHAT_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
