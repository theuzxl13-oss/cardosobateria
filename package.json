{
  "name": "cardoso-baterias",
  "version": "1.0.0",
  "private": true,
  "description": "Cardoso Baterias — site institucional, loja virtual, painel administrativo e chatbot (demonstração comercial)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "images": "node scripts/generate-images.js",
    "migrate": "node scripts/migrate.js",
    "reset-demo": "node scripts/reset-demo.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "preview": "node scripts/static-preview.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "playwright-core": "^1.63.0",
    "sql.js": "^1.14.2"
  }
}
